<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="file"
            path="history.json" />
        <include
            domain="file"
            path="TidyURLApp.preferences_pb" />
        <include
            domain="sharedpref"
            path="tidy_backup_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="file"
            path="history.json" />
        <include
            domain="file"
            path="TidyURLApp.preferences_pb" />
        <include
            domain="sharedpref"
            path="tidy_backup_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
